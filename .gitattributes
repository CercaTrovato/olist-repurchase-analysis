* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.zip binary
*.pptx binary
*.png binary

# Reviewed report-preparation artifacts are bound by byte-level SHA-256.
report-prep/20261126/** -text
# Matplotlib SVG path attributes intentionally contain end-of-line spaces.
report-prep/20261126/figures/*.svg whitespace=-blank-at-eol
# Preserve the executed Windows JSON plan/receipt bytes without flagging CRLF.
report-prep/20261126/data/feature-experiment-plan.json whitespace=cr-at-eol
report-prep/20261126/data/feature-experiment-verification.json whitespace=cr-at-eol
report-prep/20261126/review/*.json whitespace=cr-at-eol

# Preserve reviewed writing-package bytes and declared line endings.
docs/team/report-writing-20261127/** -text
docs/team/report-writing-20261127/**/*.svg whitespace=-blank-at-eol
docs/team/report-writing-20261127/**/*.csv whitespace=cr-at-eol
docs/team/report-writing-20261127/**/*.json whitespace=cr-at-eol

# Vendored IEEE class and reviewed generator retain their original whitespace.
docs/team/report-writing-20261127/template/IEEEtran.cls whitespace=-blank-at-eol,-blank-at-eof
docs/team/report-writing-20261127/template/make_figures.py whitespace=-blank-at-eof
